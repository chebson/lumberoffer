# Public address of this app, used for links in emails (no trailing slash)
APP_URL=https://offers.example.com

# Clerk (logins) - from the Clerk dashboard, API keys page
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Only these emails may sign in (comma separated). Leave blank to allow any Clerk user.
ALLOWED_EMAILS=

# Supabase (database) - Project settings, API page. The service role key stays on the server.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# Postmark (sending) - Server API token. Leave blank for test mode: sends are recorded but no email goes out.
POSTMARK_SERVER_TOKEN=
